//@version=6
indicator("Clean Trading Signal Indicator", overlay=true, max_labels_count=100, max_boxes_count=50)

// ====================================================
// Inputs
// ====================================================
showFibLevels    = input.bool(true,  "Show Fibonacci Retracement")
showSignalInfo   = input.bool(true,  "Show Signal Info Label")

ema30Len = input.int(30, "EMA 30")
ema35Len = input.int(35, "EMA 35")
ema40Len = input.int(40, "EMA 40")
ema45Len = input.int(45, "EMA 45")
ema50Len = input.int(50, "EMA 50")
ema60Len = input.int(60, "EMA 60")

rsiLen   = input.int(14, "RSI Length")
macdFast = input.int(12, "MACD Fast")
macdSlow = input.int(26, "MACD Slow")
macdSig  = input.int(9,  "MACD Signal")
atrLen   = input.int(14, "ATR Length")

fibLookback = input.int(200, "Fibonacci Lookback")

tp1Pct = input.float(0.5, "TP1 %", step=0.25)
tp2Pct = input.float(1.0, "TP2 %", step=0.25)
tp3Pct = input.float(1.5, "TP3 %", step=0.25)
tp4Pct = input.float(2.0, "TP4 %", step=0.25)
tp5Pct = input.float(2.8, "TP5 %", step=0.25)
tp6Pct = input.float(3.8, "TP6 %", step=0.25)
slPct  = input.float(1.0, "SL %", step=0.25)

// ====================================================
// Core Indicators
// ====================================================

// EMA Stack
ema30 = ta.ema(close, ema30Len)
ema35 = ta.ema(close, ema35Len)
ema40 = ta.ema(close, ema40Len)
ema45 = ta.ema(close, ema45Len)
ema50 = ta.ema(close, ema50Len)
ema60 = ta.ema(close, ema60Len)

bullishAligned = ema30 > ema35 and ema35 > ema40 and ema40 > ema45 and ema45 > ema50 and ema50 > ema60
bearishAligned = ema30 < ema35 and ema35 < ema40 and ema40 < ema45 and ema45 < ema50 and ema50 < ema60

// Price above or below EMA
priceAboveEMA = close > ema30
priceBelowEMA = close < ema30

// RSI
rsi14 = ta.rsi(close, rsiLen)
rsiBullish = rsi14 > 50 and rsi14 < 80
rsiBearish = rsi14 < 50 and rsi14 > 20

// MACD
[macdLine, signalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSig)
macdBull = macdLine > signalLine
macdBear = macdLine < signalLine

// ATR for volatility
atr14 = ta.atr(atrLen)
atrEma = ta.ema(atr14, 20)

// VWAP
vwapPrice = ta.vwap

// Price Action - Body size
bodySize = math.abs(close - open)
bullishBar = close > open and bodySize > atr14 * 0.5
bearishBar = close < open and bodySize > atr14 * 0.5

// Momentum
ema20 = ta.ema(close, 20)
priceAboveEMA20 = close > ema20
priceBelowEMA20 = close < ema20

// Support / Resistance
recent_high = ta.highest(high, 20)
recent_low = ta.lowest(low, 20)

// ====================================================
// FIBONACCI RETRACEMENT
// ====================================================
fibHigh = ta.highest(high, fibLookback)
fibLow  = ta.lowest(low, fibLookback)
fibRange = fibHigh - fibLow

if showFibLevels and barstate.islast
    fibLevels = array.from(0.236, 0.382, 0.5, 0.618, 0.786, 1.0)
    for i = 0 to array.size(fibLevels) - 1
        fibVal = array.get(fibLevels, i)
        level = fibHigh - fibRange * fibVal
        line.new(bar_index - fibLookback, level, bar_index, level, color=color.new(color.white, 0), style=line.style_dashed, extend=extend.right, width=1)
        label.new(bar_index + 5, level, str.tostring(fibVal, "#.###"),
                  xloc.bar_index, yloc.price, color=color.new(color.gray, 0), textcolor=color.white, style=label.style_label_left, size=size.small)

// ====================================================
// SIGNAL GENERATION - BALANCED APPROACH
// ====================================================

// Long Signal: More achievable conditions
longCondition1 = (bullishAligned or priceAboveEMA) and macdBull and priceAboveEMA20
longCondition2 = macdBull and rsiBullish and bullishBar and priceAboveEMA20
longCondition3 = bullishAligned and macdBull and priceAboveEMA and close > vwapPrice

longSignal = longCondition1 or longCondition2 or longCondition3

// Short Signal: More achievable conditions
shortCondition1 = (bearishAligned or priceBelowEMA) and macdBear and priceBelowEMA20
shortCondition2 = macdBear and rsiBearish and bearishBar and priceBelowEMA20
shortCondition3 = bearishAligned and macdBear and priceBelowEMA and close < vwapPrice

shortSignal = shortCondition1 or shortCondition2 or shortCondition3

// Signal Score for confidence
signalScore = 0
signalScore += bullishAligned or bearishAligned ? 25 : 0
signalScore += rsiBullish or rsiBearish ? 15 : 0
signalScore += macdBull or macdBear ? 20 : 0
signalScore += priceAboveEMA20 or priceBelowEMA20 ? 15 : 0
signalScore += bullishBar or bearishBar ? 10 : 0
signalScore += close > vwapPrice or close < vwapPrice ? 10 : 0

precisionModel = signalScore >= 75 ? "High Probability" : signalScore >= 50 ? "Medium Probability" : "Moderate Confidence"

// Avoid too many consecutive signals
var int lastSignalBar = -100

var float longTP1 = na
var float longTP2 = na
var float longTP3 = na
var float longTP4 = na
var float longTP5 = na
var float longTP6 = na
var float longSL  = na

var float shortTP1 = na
var float shortTP2 = na
var float shortTP3 = na
var float shortTP4 = na
var float shortTP5 = na
var float shortTP6 = na
var float shortSL  = na

if longSignal and (bar_index - lastSignalBar) > 5
    longTP1 := close * (1 + tp1Pct / 100)
    longTP2 := close * (1 + tp2Pct / 100)
    longTP3 := close * (1 + tp3Pct / 100)
    longTP4 := close * (1 + tp4Pct / 100)
    longTP5 := close * (1 + tp5Pct / 100)
    longTP6 := close * (1 + tp6Pct / 100)
    longSL  := close * (1 - slPct / 100)
    lastSignalBar := bar_index

if shortSignal and (bar_index - lastSignalBar) > 5
    shortTP1 := close * (1 - tp1Pct / 100)
    shortTP2 := close * (1 - tp2Pct / 100)
    shortTP3 := close * (1 - tp3Pct / 100)
    shortTP4 := close * (1 - tp4Pct / 100)
    shortTP5 := close * (1 - tp5Pct / 100)
    shortTP6 := close * (1 - tp6Pct / 100)
    shortSL  := close * (1 + slPct / 100)
    lastSignalBar := bar_index

// ====================================================
// PLOT SIGNALS
// ====================================================
plotshape(longSignal and (bar_index - lastSignalBar) == 0, title="Buy Signal", style=shape.labelup, location=location.belowbar, color=color.new(color.lime, 0), text="BUY", textcolor=color.white, size=size.large)
plotshape(shortSignal and (bar_index - lastSignalBar) == 0, title="Sell Signal", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), text="SELL", textcolor=color.white, size=size.large)

// ====================================================
// SIGNAL INFO LABEL
// ====================================================
if showSignalInfo and barstate.islast and ((longSignal and (bar_index - lastSignalBar) == 0) or (shortSignal and (bar_index - lastSignalBar) == 0))
    if longSignal and (bar_index - lastSignalBar) == 0
        label.new(bar_index, close + atr14 * 0.5,
                  "🔼 BUY\nEntry: " + str.tostring(close, format.mintick) +
                  "\nSL: " + str.tostring(longSL, format.mintick) +
                  "\nTP1: " + str.tostring(longTP1, format.mintick) +
                  "\nTP6: " + str.tostring(longTP6, format.mintick) +
                  "\nRSI: " + str.tostring(rsi14, "#.##") +
                  "\nConfidence: " + precisionModel,
                  style=label.style_label_down, color=color.new(color.lime, 0), textcolor=color.white, size=size.small)

    if shortSignal and (bar_index - lastSignalBar) == 0
        label.new(bar_index, close - atr14 * 0.5,
                  "🔽 SELL\nEntry: " + str.tostring(close, format.mintick) +
                  "\nSL: " + str.tostring(shortSL, format.mintick) +
                  "\nTP1: " + str.tostring(shortTP1, format.mintick) +
                  "\nTP6: " + str.tostring(shortTP6, format.mintick) +
                  "\nRSI: " + str.tostring(rsi14, "#.##") +
                  "\nConfidence: " + precisionModel,
                  style=label.style_label_up, color=color.new(color.red, 0), textcolor=color.white, size=size.small)

// ====================================================
// ALERTS
// ====================================================
alertcondition(longSignal and (bar_index - lastSignalBar) == 0, title="Long Signal", message="🔼 BUY - Entry: {{close}}")
alertcondition(shortSignal and (bar_index - lastSignalBar) == 0, title="Short Signal", message="🔽 SELL - Entry: {{close}}")
